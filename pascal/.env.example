# All VITE_* values are public and are inlined at build time. Never put keys here.
# Pascal hosting permits editor.pascal.app as the API origin.
VITE_PASCAL_BASE_URL=https://editor.pascal.app
# Defaults to VITE_PASCAL_BASE_URL when empty.
VITE_PASCAL_ASSETS_URL=
VITE_PASCAL_PROJECT_ID=
# auto | baked | live. These options are reserved for the later data-loading slice.
VITE_PASCAL_SOURCE=auto
# Opt-in trees and bake polling are reserved for later runtime slices.
VITE_PASCAL_PLUGIN_TREES=0
VITE_PASCAL_POLL_BAKE=0
